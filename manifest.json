{
  "id": "snippets",
  "name": "Snippets",
  "version": "1.2.0",
  "description": "Save the commands you run often and run them in a terminal or on many hosts in one click.",
  "author": {
    "name": "Termix"
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/Termix-SSH/Plugin-Snippets",
  "docs": "https://docs.termix.site/plugins/snippets",
  "video": "https://www.youtube.com/watch?v=g2TJdWLKhJI",
  "category": "Productivity",
  "icon": "Play",
  "features": [
    "Save commands and notes in folders",
    "Run them in one or more terminals, or straight on a set of hosts",
    "Variables for the host and your own inputs",
    "Encrypted secrets you can use as {{NAME}} in a command",
    "Run a snippet each time you connect to a host",
    "Share snippets with users or roles",
    "Import and export as JSON",
    "A snippets panel beside any SSH terminal",
    "A dashboard card to run host snippets or copy any snippet"
  ],
  "env": [
    {
      "name": "SNIPPET_EXECUTION_TIMEOUT_SECONDS",
      "description": "Stop a snippet run on hosts after this many seconds. Unset means no limit."
    }
  ],
  "engine": {
    "termix": ">=26.10.0",
    "api": "^1.2"
  },
  "capabilities": [
    "db:own",
    "network:serve",
    "ssh:connect",
    "credentials:use",
    "credentials:read",
    "hosts:write",
    "ui:surface",
    "events:core",
    "db:core-refs",
    "secrets:own"
  ],
  "provides": [
    {
      "service": "snippets.access",
      "version": "1.0.0",
      "permission": "snippets.view"
    }
  ],
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"],
  "contributes": {
    "panels": [
      {
        "id": "snippets",
        "titleKey": "nav.snippets",
        "icon": "Play"
      }
    ],
    "permissions": [
      {
        "name": "view",
        "titleKey": "permissions.view.title",
        "descriptionKey": "permissions.view.description",
        "defaultRoles": ["user"]
      },
      {
        "name": "create",
        "titleKey": "permissions.create.title",
        "descriptionKey": "permissions.create.description",
        "defaultRoles": ["user"]
      },
      {
        "name": "edit",
        "titleKey": "permissions.edit.title",
        "descriptionKey": "permissions.edit.description",
        "defaultRoles": ["user"]
      },
      {
        "name": "delete",
        "titleKey": "permissions.delete.title",
        "descriptionKey": "permissions.delete.description",
        "defaultRoles": ["user"]
      },
      {
        "name": "share",
        "titleKey": "permissions.share.title",
        "descriptionKey": "permissions.share.description",
        "defaultRoles": ["user"]
      }
    ],
    "settings": {
      "user": [
        {
          "key": "foldersCollapsed",
          "type": "boolean",
          "labelKey": "settings.foldersCollapsed.label",
          "descriptionKey": "settings.foldersCollapsed.description",
          "default": true
        },
        {
          "key": "showCommands",
          "type": "boolean",
          "labelKey": "settings.showCommands.label",
          "descriptionKey": "settings.showCommands.description",
          "default": true
        },
        {
          "key": "alwaysShowActions",
          "type": "boolean",
          "labelKey": "settings.alwaysShowActions.label",
          "descriptionKey": "settings.alwaysShowActions.description",
          "default": true
        },
        {
          "key": "confirmExecution",
          "type": "boolean",
          "labelKey": "settings.confirmExecution.label",
          "descriptionKey": "settings.confirmExecution.description",
          "default": false
        },
        {
          "key": "fillSudoPassword",
          "type": "boolean",
          "labelKey": "settings.fillSudoPassword.label",
          "descriptionKey": "settings.fillSudoPassword.description",
          "default": false
        },
        {
          "key": "companionAutoOpen",
          "type": "boolean",
          "labelKey": "settings.companionAutoOpen.label",
          "descriptionKey": "settings.companionAutoOpen.description",
          "default": false
        },
        {
          "key": "companionSide",
          "type": "select",
          "labelKey": "settings.companionSide.label",
          "descriptionKey": "settings.companionSide.description",
          "default": "right",
          "options": [
            {
              "value": "right",
              "labelKey": "settings.companionSide.right"
            },
            {
              "value": "left",
              "labelKey": "settings.companionSide.left"
            },
            {
              "value": "bottom",
              "labelKey": "settings.companionSide.bottom"
            }
          ]
        },
        {
          "key": "companionSize",
          "type": "number",
          "labelKey": "settings.companionSize.label",
          "descriptionKey": "settings.companionSize.description",
          "min": 240,
          "max": 900,
          "default": 360
        },
        {
          "key": "companionEdgeButton",
          "type": "boolean",
          "labelKey": "settings.companionEdgeButton.label",
          "descriptionKey": "settings.companionEdgeButton.description",
          "default": true
        }
      ],
      "host": {
        "editorGroup": "ssh",
        "editorOrder": 15,
        "fields": [
          {
            "key": "startupSnippetId",
            "type": "number",
            "labelKey": "host.startupTitle",
            "descriptionKey": "host.startupDescription",
            "hidden": true,
            "min": 1,
            "shareRead": "view",
            "defaultLevels": ["user", "folder"]
          },
          {
            "key": "quickActions",
            "type": "json",
            "labelKey": "host.quickActionsTitle",
            "descriptionKey": "host.quickActionsDescription",
            "hidden": true,
            "default": [],
            "shareRead": "view",
            "defaultLevels": ["user", "folder"]
          },
          {
            "key": "showPanel",
            "type": "boolean",
            "labelKey": "host.settings.showPanel.label",
            "descriptionKey": "host.settings.showPanel.description",
            "default": true
          }
        ]
      }
    },
    "syncEntities": ["snippetFolders", "snippets"],
    "keybindingActions": [
      {
        "id": "runSnippet",
        "params": {
          "snippetId": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "maxLength": 20,
            "syncEntity": "snippets"
          },
          "appendEnter": {
            "type": "boolean"
          }
        }
      }
    ],
    "http": {
      "adminImpersonation": true
    },
    "uses": [
      "host-metrics.toolbar",
      "terminal.sendToActive",
      "terminal.sendToSession",
      "terminal.listSessions"
    ],
    "dashboardCards": [
      {
        "id": "snippets",
        "titleKey": "card.title",
        "icon": "Play"
      }
    ]
  }
}
